AUTH_SECRET=replace-with-32-plus-random-chars

# Database — leave DATABASE_URL unset to use SQLite instead.
# DATABASE_URL=postgres://user:pass@localhost:5432/automotivemaint
# SQLITE_DB_PATH=./data/maintenance.db

PORT=3000
NODE_ENV=development

# Cloudflare R2 (optional — receipt image uploads)
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=
